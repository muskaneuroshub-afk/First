# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (FRONTEND)
# ==============================================================================
# Copy this file to `.env` and adjust if needed.
#
# NOTE: Variables prefixed with `VITE_` are bundled into the client build and are
# publicly readable in browser network requests. Never put secret private keys,
# database credentials, or admin tokens in these variables.
# ==============================================================================

# Backend API URL (point to your running Node.js / Express backend server)
# If left blank, the website displays an honest "not configured yet" banner
# and guides visitors to use direct email.
VITE_API_BASE_URL=http://localhost:4000

# Optional: Production site URL for canonical link tags and Open Graph metadata
VITE_SITE_URL=https://your-portfolio-domain.com
