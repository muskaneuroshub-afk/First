# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (dev). For production swap to: postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./prisma/dev.db"

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash, no wildcards)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Security ──────────────────────────────────────────────────────────────────
# Long random string used to salt IP hashes — never share or commit this value
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
IP_HASH_SALT=change_me_to_a_long_random_string_at_least_32_chars

# ── Rate Limiting ─────────────────────────────────────────────────────────────
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=15

# ── Admin API ─────────────────────────────────────────────────────────────────
# When blank, all /api/admin/* routes return 404. Must be ≥32 chars when set.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_API_TOKEN=

# ── Email Notifications (all six required to enable email) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFY_TO=
MAIL_FROM=

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Set to true only when behind a trusted reverse proxy (nginx, Heroku, Railway…)
TRUST_PROXY=false

